ipvs_sa <- ipvs_2022 %>%
filter(code_muni == "3547809") %>%
st_transform(31983) %>%
st_intersection(municipio_sa)
# ==============================
# CLASSIFICAÇÃO IPVS (PADRONIZAÇÃO)
# ==============================
ipvs_sa <- ipvs_sa %>%
mutate(
IPVS_classe = case_when(
N_IPVS == "Muito Baixa Vulnerabilidade" ~ "Muito baixa vulnerabilidade",
N_IPVS == "Baixa Vulnerabilidade"       ~ "Baixa vulnerabilidade",
N_IPVS == "Média Vulnerabilidade"       ~ "Média vulnerabilidade",
N_IPVS == "Alta Vulnerabilidade"        ~ "Alta vulnerabilidade",
N_IPVS == "Muito Alta Vulnerabilidade"  ~ "Muito alta vulnerabilidade",
N_IPVS == "Altíssima Vulnerabilidade"   ~ "Altíssima vulnerabilidade",
TRUE ~ "Não classificado"
)
)
# ==============================
# ORDENAÇÃO DA LEGENDA
# ==============================
ipvs_sa$IPVS_classe <- factor(
ipvs_sa$IPVS_classe,
levels = c(
"Muito baixa vulnerabilidade",
"Baixa vulnerabilidade",
"Média vulnerabilidade",
"Alta vulnerabilidade",
"Muito alta vulnerabilidade",
"Altíssima vulnerabilidade",
"Não classificado"
)
)
